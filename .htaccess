# MultiViews must stay off: it serves product-details.html for /product-details/slug
# before mod_rewrite runs, which returns a 404.
Options -Indexes -MultiViews
RewriteEngine On

# Old category links (products?category=slug, products.html?category=slug) → /products/slug (301).
# Captures from THE_REQUEST so the site's sub-folder (e.g. /marken/) is kept.
RewriteCond %{THE_REQUEST} \s/([^\s?]*?)products(?:\.html)?\?category=([^&\s]+)\s [NC]
RewriteRule ^ /%1products/%2? [R=301,L]

# Old article links (blog-details?slug=x, blog-details.html?slug=x) → /blog-details/x (301).
# Only when slug is the sole parameter, so admin previews (?slug=x&preview=1) are never redirected.
RewriteCond %{THE_REQUEST} \s/([^\s?]*?)blog-details(?:\.html)?\?slug=([^&\s]+)\s [NC]
RewriteRule ^ /%1blog-details/%2? [R=301,L]

# Clean article URLs: /blog-details/slug → blog-details.html?slug=slug
RewriteRule ^blog-details/([^/]+)/?$ blog-details.html?slug=$1 [L,QSA]

# Clean product-detail URLs: /product-details/slug → product-details.html?slug=slug
RewriteRule ^product-details/([^/]+)/?$ product-details.html?slug=$1 [L,QSA]

# Clean category URLs: /products/slug → products.html?category=slug
RewriteRule ^products/([^/]+)/?$ products.html?category=$1 [L,QSA]

# Remove .html extension from flat pages (e.g. /products → /products.html)
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^([^/]+)$ $1.html [L]

# Redirect .html requests to clean URL (301 permanent)
RewriteCond %{THE_REQUEST} \s/([^.]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Never serve source/config files.
<FilesMatch "^(package(-lock)?\.json|CLAUDE\.md|\.gitignore|\.user\.ini)$">
  Require all denied
</FilesMatch>
